{
  "info": {
    "_postman_id": "c1f6b158-9be1-4dd9-a5e3-4f91e92d77a1",
    "name": "Nearby Services Platform API",
    "description": "Production Postman collection for the Nearby Services Platform (FastAPI + PostGIS + Redis). Includes Public APIs, Authentication, and Admin Service Management.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "serviceId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access_token) {",
                  "    pm.collectionVariables.set('accessToken', jsonData.access_token);",
                  "}",
                  "if (jsonData.refresh_token) {",
                  "    pm.collectionVariables.set('refreshToken', jsonData.refresh_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@nearby.local\",\n  \"password\": \"ChangeMe123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        },
        {
          "name": "Get Current Admin (Me)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "me"]
            }
          }
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access_token) {",
                  "    pm.collectionVariables.set('accessToken', jsonData.access_token);",
                  "}",
                  "if (jsonData.refresh_token) {",
                  "    pm.collectionVariables.set('refreshToken', jsonData.refresh_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "refresh"]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "Public Services",
      "item": [
        {
          "name": "List Categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/services/categories",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "services", "categories"]
            }
          }
        },
        {
          "name": "List Services (Paginated / Filtered)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/services?page=1&page_size=20&category=hospital&q=",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "services"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "page_size",
                  "value": "20"
                },
                {
                  "key": "category",
                  "value": "hospital"
                },
                {
                  "key": "q",
                  "value": ""
                }
              ]
            }
          }
        },
        {
          "name": "Nearby Search (Geospatial Radius)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/services/nearby?latitude=12.9716&longitude=77.5946&radius_km=5&limit=50",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "services", "nearby"],
              "query": [
                {
                  "key": "latitude",
                  "value": "12.9716"
                },
                {
                  "key": "longitude",
                  "value": "77.5946"
                },
                {
                  "key": "radius_km",
                  "value": "5"
                },
                {
                  "key": "limit",
                  "value": "50"
                }
              ]
            }
          }
        },
        {
          "name": "Map Bounding Box Query",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/services/map?min_lat=12.90&min_lng=77.50&max_lat=13.05&max_lng=77.70&limit=300",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "services", "map"],
              "query": [
                {
                  "key": "min_lat",
                  "value": "12.90"
                },
                {
                  "key": "min_lng",
                  "value": "77.50"
                },
                {
                  "key": "max_lat",
                  "value": "13.05"
                },
                {
                  "key": "max_lng",
                  "value": "77.70"
                },
                {
                  "key": "limit",
                  "value": "300"
                }
              ]
            }
          }
        },
        {
          "name": "Get Service Details by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/services/{{serviceId}}?latitude=12.9716&longitude=77.5946",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "services", "{{serviceId}}"],
              "query": [
                {
                  "key": "latitude",
                  "value": "12.9716"
                },
                {
                  "key": "longitude",
                  "value": "77.5946"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Admin Management",
      "item": [
        {
          "name": "Admin Dashboard Stats",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
