              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Apollo Clinic Indiranagar (Renovated)\",\n  \"category\": \"hospital\",\n  \"latitude\": 12.9719,\n  \"longitude\": 77.6412,\n  \"rating\": 4.9,\n  \"metadata\": {\n    \"address\": \"100 Feet Road, Indiranagar, Bengaluru\",\n    \"phone\": \"+91-80-2525-0000\",\n    \"description\": \"Expanded multi-specialty center with cardiology wing.\"\n  }\n}"
            },
            "url": {
