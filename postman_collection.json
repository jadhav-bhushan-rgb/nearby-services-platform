        },
        {
          "name": "Delete Service",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/services/{{serviceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "services", "{{serviceId}}"]
            }
          }
        },
        {
          "name": "Bulk Upload Services (CSV/JSON)",
          "request": {
            "auth": {
