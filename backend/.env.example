SEED_SAMPLE_DATA=true

RATE_LIMIT_PUBLIC_PER_MIN=60
RATE_LIMIT_SEARCH_PER_MIN=30
RATE_LIMIT_LOGIN_PER_MIN=5

CACHE_TTL_LIST_SECONDS=60
